{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "es2022"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": [
      "@org/source"
    ],
    "paths": {
      "ng_remote1/Routes": [
        "./packages/nx-angular/ng_remote1/src/app/remote-entry/entry.routes.ts"
      ],
      "ng_remote2/Routes": [
        "./packages/nx-angular/ng_remote2/src/app/remote-entry/entry.routes.ts"
      ],
      "ng_remote3/Routes": [
        "./packages/nx-angular/ng_remote3/src/app/remote-entry/entry.routes.ts"
      ]
    }
  }
}
