{
  "name": "ng_remote2",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "packages/nx-angular/ng_remote2/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:webpack-browser",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/packages/nx-angular/ng_remote2",
        "index": "packages/nx-angular/ng_remote2/src/index.html",
        "main": "packages/nx-angular/ng_remote2/src/main.ts",
        "tsConfig": "packages/nx-angular/ng_remote2/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "packages/nx-angular/ng_remote2/public"
          }
        ],
        "styles": [
          "packages/nx-angular/ng_remote2/src/styles.css"
        ],
        "customWebpackConfig": {
          "path": "packages/nx-angular/ng_remote2/webpack.config.ts"
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "customWebpackConfig": {
            "path": "packages/nx-angular/ng_remote2/webpack.prod.config.ts"
          }
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/angular:dev-server",
      "options": {
        "port": 4202,
        "publicHost": "http://localhost:4202"
      },
      "configurations": {
        "production": {
          "buildTarget": "ng_remote2:build:production"
        },
        "development": {
          "buildTarget": "ng_remote2:build:development"
        }
      },
      "defaultConfiguration": "development",
      "dependsOn": [
        "ng-host:serve"
      ]
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "ng_remote2:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{options.reportsDirectory}"
      ],
      "options": {
        "reportsDirectory": "coverage/packages/nx-angular/ng_remote2"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "defaultConfiguration": "production",
      "options": {
        "buildTarget": "ng_remote2:build",
        "port": 4202,
        "watch": false
      },
      "configurations": {
        "development": {
          "buildTarget": "ng_remote2:build:development"
        },
        "production": {
          "buildTarget": "ng_remote2:build:production"
        }
      }
    }
  }
}
